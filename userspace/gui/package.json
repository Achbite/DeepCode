{
  "name": "@deepcode/client",
  "version": "0.5.51",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:deepcode-gui": "vite --config vite.deepcode-gui.config.ts",
    "build": "pnpm run build:types && pnpm run build:web",
    "build:types": "tsc --noEmit",
    "build:web": "vite build",
    "build:deepcode-gui": "pnpm run build:types && pnpm run build:deepcode-gui:web",
    "build:deepcode-gui:web": "vite build --config vite.deepcode-gui.config.ts && if [ -f dist-deepcode-gui/deepcode-gui.html ]; then cp dist-deepcode-gui/deepcode-gui.html dist-deepcode-gui/index.html; fi",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/session-contract.test.mjs"
  },
  "dependencies": {
    "@deepcode/presentation-core": "workspace:*",
    "@deepcode/protocol": "workspace:*",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "diff": "8.0.2",
    "hast-util-to-jsx-runtime": "2.3.6",
    "katex": "^0.17.0",
    "mermaid": "^11.15.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "unified": "11.0.5",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@types/hast": "3.0.4",
    "@types/mdast": "4.0.4",
    "@types/node": "^22.19.19",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "monaco-editor": "^0.55.1",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  }
}
