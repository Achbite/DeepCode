{
  "schemaVersion": 1,
  "defaultProfile": "required",
  "governance": {
    "testChangesRequireUserApproval": true,
    "reviewModel": "procedural-release-task",
    "policyPath": "tests/protected-paths.json",
    "gatePath": "scripts/test-change-gate.py",
    "requestTemplatePath": "docs/test-change-request.md"
  },
  "profiles": {
    "required": {
      "description": "Authoritative repository gate containing every and only requiredGate suite; it never runs smoke checks or degrades to host static checks.",
      "suites": [
        "repository.legacy"
      ]
    },
    "static": {
      "description": "Explicit host-safe shell, controller, architecture, and branch-flow checks.",
      "suites": [
        "repository.static"
      ]
    },
    "smoke": {
      "description": "Non-authoritative focused Session agent-loop and selected historical-defect smoke checks.",
      "suites": [
        "session.smoke"
      ]
    },
    "regression": {
      "description": "Non-authoritative transitional Session regression coverage retained for later contract audit.",
      "suites": [
        "session.legacy-regression"
      ]
    },
    "full": {
      "description": "Non-authoritative run of required integration, transitional Session regression, and focused smoke suites.",
      "suites": [
        "repository.legacy",
        "session.legacy-regression",
        "session.smoke"
      ]
    }
  },
  "suites": [
    {
      "id": "repository.static",
      "description": "Host-safe static repository contracts formerly embedded in test.sh.",
      "layer": "cross-layer",
      "kind": "static",
      "owner": "repository",
      "approvalClass": "test-runtime",
      "requiredGate": false,
      "transitional": false,
      "runner": {
        "type": "shell",
        "path": "scripts/tests/static-contracts.sh",
        "args": [],
        "timeoutSeconds": 300,
        "terminateGraceSeconds": 5
      },
      "environment": {
        "container": "optional",
        "hostPolicy": "allowed"
      },
      "resources": [],
      "contractSources": [
        "scripts/tests/controller-contracts.py",
        "scripts/tests/test-change-gate-contracts.py",
        "scripts/test-change-gate.py",
        "scripts/branch-flow.sh",
        "tests/protected-paths.json",
        "scripts/check-architecture.sh",
        "scripts/test-branch-flow.sh"
      ]
    },
    {
      "id": "repository.legacy",
      "description": "Transitional required Rust, TypeScript build, daemon, Host Web, and IPC suite; Session smoke checks are registered separately.",
      "layer": "cross-layer",
      "kind": "integration",
      "owner": "repository",
      "approvalClass": "test-runtime",
      "requiredGate": true,
      "transitional": true,
      "runner": {
        "type": "shell",
        "path": "scripts/tests/repository-legacy.sh",
        "args": [],
        "timeoutSeconds": 7200,
        "terminateGraceSeconds": 10
      },
      "environment": {
        "container": "preferred",
        "hostPolicy": "explicit-opt-in",
        "hostOptInEnv": "DEEPCODE_ALLOW_HOST_TEST"
      },
      "resources": [
        "kernel-daemon",
        "host-web-proxy",
        "temporary-config-directory",
        "temporary-logs"
      ],
      "contractSources": [
        "scripts/tests/repository-legacy.sh"
      ]
    },
    {
      "id": "session.legacy-regression",
      "description": "Non-authoritative legacy Session and timeline regression coverage pending stable-contract extraction.",
      "layer": "session",
      "kind": "regression",
      "owner": "session",
      "approvalClass": "test-runtime",
      "requiredGate": false,
      "transitional": true,
      "runner": {
        "type": "shell",
        "path": "scripts/tests/session-legacy-regression.sh",
        "args": [],
        "timeoutSeconds": 1200,
        "terminateGraceSeconds": 5
      },
      "environment": {
        "container": "optional",
        "hostPolicy": "allowed"
      },
      "resources": [],
      "contractSources": [
        "userspace/session-core/package.json",
        "userspace/session-core/src/__tests__/agentPlanSmoke.ts",
        "userspace/session-core/src/__tests__/timelineDeltaProjectionSmoke.ts",
        "userspace/session-core/src/__tests__/smokeAuthorityLedgerTests.ts",
        "userspace/session-core/src/__tests__/smokeFixtures.ts",
        "userspace/session-core/src/__tests__/smokeHelpers.ts",
        "userspace/session-core/src/__tests__/smokeLoopContextTests.ts",
        "userspace/session-core/src/__tests__/smokeNativeToolPipelineTests.ts",
        "userspace/session-core/src/__tests__/smokePromptContextTests.ts",
        "userspace/session-core/src/__tests__/smokeStaticSyntaxReviewTests.ts",
        "userspace/session-core/src/__tests__/smokeTerminalGuidanceTests.ts"
      ]
    },
    {
      "id": "session.smoke",
      "description": "Non-authoritative focused Session agent-loop and selected historical-defect smoke checks.",
      "layer": "session",
      "kind": "smoke",
      "owner": "session",
      "approvalClass": "test-runtime",
      "requiredGate": false,
      "transitional": false,
      "runner": {
        "type": "shell",
        "path": "scripts/tests/session-smoke.sh",
        "args": [],
        "timeoutSeconds": 300,
        "terminateGraceSeconds": 5
      },
      "environment": {
        "container": "optional",
        "hostPolicy": "allowed"
      },
      "resources": [],
      "contractSources": [
        "userspace/session-core/package.json",
        "userspace/session-core/src/__tests__/agentLoopSmoke.ts",
        "userspace/session-core/src/__tests__/smokeFixtures.ts",
        "userspace/session-core/src/__tests__/smokeHelpers.ts"
      ]
    }
  ]
}
