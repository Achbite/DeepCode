    {
      "id": "session.smoke.communication",
      "description": "Bounded RunOpen/ToolContext and instruction-answer communication checks.",
      "layer": "session",
      "kind": "smoke",
      "owner": "session",
      "approvalClass": "test-runtime",
      "requiredGate": false,
      "transitional": false,
      "group": "communication",
      "cases": [
        {
          "id": "communication.run_open_tool_context",
          "incidentRef": "kernel-session-v2:run-open-context-handoff",
          "invariant": "RunOpen v2 ToolContext reaches the actual Provider request without capability secrets.",
          "sourcePath": "userspace/session-core/tests/smoke/communication.mjs"
        },
        {
          "id": "communication.instruction_answer_roundtrip",
          "incidentRef": "git:5f8bafd-semantic-provider-loop",
          "invariant": "The current user instruction reaches the Provider and its answer becomes the final Session projection.",
          "sourcePath": "userspace/session-core/tests/smoke/communication.mjs"
        }
      ],
      "runner": {
        "type": "shell",
        "path": "scripts/tests/session-smoke.sh",
        "args": ["communication"],
        "timeoutSeconds": 300,
        "terminateGraceSeconds": 5
      },
      "environment": {
        "container": "optional",
        "hostPolicy": "allowed"
