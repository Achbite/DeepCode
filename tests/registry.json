{
  "schemaVersion": 1,
  "defaultProfile": "required",
  "governance": {
    "testChangesRequireUserApproval": true,
    "reviewModel": "procedural-release-task",
    "policyPath": "tests/protected-paths.json",
    "gatePath": "scripts/test-change-gate.py",
    "requestTemplatePath": "docs/test-change-request.md",
    "smokePolicy": {
      "scope": "runtime-path-and-historical-defects",
      "caseRegistration": "exact-controller-handshake",
      "maxCasesPerSuite": 3,
      "maxSuites": 4,
      "maxTotalCases": 5
    }
  },
  "profiles": {
    "required": {
      "description": "Required repository integration evidence gate containing every and only requiredGate suite; it never runs smoke checks or degrades to host static checks.",
      "suites": [
        "repository.required",
        "kernel.v2.contracts",
        "session.v2.contracts",
        "host.v2.integration"
      ]
    },
    "static": {
      "description": "Explicit host-safe shell, controller, architecture, and branch-flow checks.",
      "suites": [
        "repository.static"
      ]
    },
    "smoke": {
      "description": "Supporting Session runtime-path checks grouped by historical failure class.",
      "suites": [
        "session.smoke.communication",
        "session.smoke.tools",
        "session.smoke.paths",
        "session.smoke.loop"
      ]
    },
    "full": {
      "description": "Supporting run of the required integration gate followed by every registered smoke group.",
      "suites": [
        "repository.required",
        "kernel.v2.contracts",
        "session.v2.contracts",
        "host.v2.integration",
        "session.smoke.communication",
        "session.smoke.tools",
        "session.smoke.paths",
        "session.smoke.loop"
      ]
    }
  },
  "suites": [
    {
      "id": "repository.static",
      "description": "Host-safe static repository contracts formerly embedded in test.sh.",
      "layer": "cross-layer",
      "kind": "static",
      "owner": "repository",
      "approvalClass": "test-runtime",
      "requiredGate": false,
      "transitional": false,
      "runner": {
        "type": "shell",
        "path": "scripts/tests/static-contracts.sh",
        "args": [],
        "timeoutSeconds": 300,
        "terminateGraceSeconds": 5
      },
      "environment": {
        "container": "optional",
        "hostPolicy": "allowed"
      },
      "resources": [],
      "contractSources": [
        "scripts/tests/controller-contracts.py",
        "scripts/tests/test-change-gate-contracts.py",
        "scripts/test-change-gate.py",
        "scripts/branch-flow.sh",
        "tests/protected-paths.json",
        "scripts/check-architecture.sh",
        "scripts/test-branch-flow.sh",
        "scripts/tests/repository-required.sh",
        "scripts/tests/kernel-v2-contracts.sh",
        "scripts/tests/session-v2-contracts.sh",
        "scripts/tests/legacy-cutover-contracts.py"
      ]
    },
    {
      "id": "repository.required",
      "description": "Required production builds and v2 legacy-cutover semantic contracts.",
      "layer": "cross-layer",
      "kind": "integration",
      "owner": "repository",
      "approvalClass": "test-runtime",
      "requiredGate": true,
      "transitional": false,
      "runner": {
        "type": "shell",
        "path": "scripts/tests/repository-required.sh",
        "args": [],
        "timeoutSeconds": 7200,
        "terminateGraceSeconds": 10
      },
      "environment": {
        "container": "preferred",
        "hostPolicy": "explicit-opt-in",
        "hostOptInEnv": "DEEPCODE_ALLOW_HOST_TEST"
      },
      "resources": [],
      "contractSources": [
        "scripts/tests/repository-required.sh",
        "scripts/tests/legacy-cutover-contracts.py"
      ]
    },
    {
