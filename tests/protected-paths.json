{
  "schemaVersion": 2,
  "releaseReview": {
    "type": "procedural-release-task",
    "defaultLifetimeSeconds": 3600,
    "maxLifetimeSeconds": 86400,
    "clockSkewSeconds": 300
  },
  "categories": [
    {
      "id": "test-runtime",
      "description": "Repository test entrypoints, controllers, registries, and suite runners.",
      "pathPatterns": [
        "test.sh",
        "tests/registry.json",
        "scripts/test-controller.py",
        "scripts/tests/**"
      ]
    },
    {
      "id": "test-contract",
      "description": "Test cases and contract checks across supported languages.",
      "pathPatterns": [
        "tests/**",
        "test/**",
        "__tests__/**",
        "**/tests/**",
        "**/test/**",
        "**/__tests__/**",
        "**/*.test.*",
        "**/*.spec.*",
        "**/test.rs",
        "**/tests.rs",
        "scripts/test-*.sh"
      ]
    },
    {
      "id": "test-data",
      "description": "Fixtures, mocks, snapshots, golden vectors, and assertion helpers.",
      "pathPatterns": [
        "fixtures/**",
        "mocks/**",
        "snapshots/**",
        "golden/**",
        "**/fixtures/**",
        "**/__fixtures__/**",
        "**/mocks/**",
        "**/__mocks__/**",
        "**/snapshots/**",
        "**/__snapshots__/**",
        "**/golden/**",
        "**/*.snap",
        "**/*.golden"
      ]
    },
    {
      "id": "test-policy",
      "description": "The classifier, policy, branch gate, hooks, and release-review documentation.",
      "pathPatterns": [
        "tests/protected-paths.json",
        ".gitattributes",
        "**/.gitattributes",
        "scripts/test-change-gate.py",
        "scripts/branch-flow.sh",
        "scripts/test-branch-flow.sh",
        "scripts/check-architecture.sh",
        ".githooks/**",
        ".github/CODEOWNERS",
        ".github/workflows/**",
        "docs/test-change-request.md",
        "AGENTS.md"
      ]
    }
  ],
  "changedLineRules": [
    {
      "id": "test-command",
      "description": "Build metadata or task files whose changed lines alter test commands.",
      "pathPatterns": [
        "Makefile",
        "**/Makefile",
        "package.json",
        "**/package.json",
        "Cargo.toml",
        "**/Cargo.toml",
        "tsconfig.json",
        "tsconfig.*.json",
        "**/tsconfig.json",
        "**/tsconfig.*.json",
        "pnpm-workspace.yaml"
      ],
      "linePatterns": [
        "(?i)test\\.sh",
        "(?i)\\b(test|tests|testing|smoke|fixture|snapshot|golden|vitest|jest|pytest)\\b",
        "(?i)cargo\\s+test",
        "(?i)node:test",
        "__tests__"
      ]
    },
    {
      "id": "test-documentation",
      "description": "Documentation changes that redefine test execution or review policy.",
      "pathPatterns": [
        "README.md",
        "README.*.md",
        "docs/**",
        "AGENTS.md"
      ],
      "linePatterns": [
        "(?i)test\\.sh",
        "(?i)\\b(test|tests|testing|smoke|suite|fixture|assert|snapshot|golden|approval|gate)\\b",
        "(测试|断言|套件|夹具|快照|批准|审批|复核|门禁)"
      ]
    }
  ],
  "inlineTestRules": [
    {
      "id": "inline-test",
      "description": "Rust source changes at or after an inline test marker.",
      "pathPatterns": [
        "*.rs",
        "**/*.rs"
      ],
      "markerPatterns": [
        "^\\s*#\\s*\\[(?:cfg|cfg_attr)\\s*\\([^]]*\\btest\\b[^]]*\\)\\s*\\]",
        "^\\s*#\\s*\\[(?:(?:tokio::)?test|rstest|test_case|proptest)(?:\\([^]]*\\))?\\s*\\]",
        "^\\s*mod\\s+tests\\s*(?:\\{|;)"
      ]
    }
  ]
}
